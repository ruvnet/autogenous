{
  "name": "radio-moe",
  "version": "0.3.1",
  "description": "Radio real-time streaming peer expert mesh — bounded, signed, constitution-pinned distributed MoE. @metaharness/radio is the metadata-only control plane; a signed direct peer transport carries expert streams. True logit mixing where tokenizers match; safe text-primary racing otherwise.",
  "type": "module",
  "license": "MIT",
  "author": "rUv",
  "repository": "https://github.com/ruvnet/autogenous",
  "keywords": [
    "mixture-of-experts",
    "moe",
    "p2p",
    "webrtc",
    "streaming",
    "realtime",
    "agents",
    "gating",
    "top-k-routing",
    "pubsub"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx examples/local-mesh.ts",
    "mesh": "node --import tsx examples/mesh-run.ts",
    "bench": "node --import tsx examples/bench.ts",
    "evolve": "node --import tsx examples/evolve-run.ts",
    "example:custom": "node --import tsx examples/custom-harness.ts",
    "bench:fusion": "node --import tsx examples/bench-fusion.ts",
    "bench:failover": "node --import tsx examples/bench-failover.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "bench:false-alert": "node --import tsx examples/bench-false-alert.ts"
  },
  "dependencies": {
    "@metaharness/radio": "^0.1.0"
  },
  "optionalDependencies": {
    "trystero": "^0.25.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
